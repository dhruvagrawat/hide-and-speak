EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# true = skip Supabase auth, explore the UI with canned data (see lib/demo.ts)
EXPO_PUBLIC_DEMO_MODE=false

# Test login for the real auth flow (no real SMS). Configure the SAME phone +
# code in Supabase → Authentication → Providers → Phone → "Test OTP". Not a
# secret — it only works because Supabase is told to accept this exact pair.
EXPO_PUBLIC_TEST_PHONE=+911000000000
EXPO_PUBLIC_TEST_OTP=123456
