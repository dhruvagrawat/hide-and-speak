{
  "expo": {
    "name": "Hidea & Speak",
    "slug": "hidea-speak",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hideaspeak",
    "userInterfaceStyle": "dark",
    "platforms": ["android"],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D"
      },
      "package": "com.hideaspeak.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hidea & Speak to access your photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Hidea & Speak to access your photos.",
          "savePhotosPermission": "Allow Hidea & Speak to save photos to your gallery."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
